// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              String   @id @unique
  contractId      String
  ledger          Int
  timestamp       Int
  txHash          String
  topics          Json     // Store as JSON array
  data            String   // Hex-encoded event data
  description     String?  // Translated human-readable text
  status          String   // "translated" | "cryptic"
  blueprintName   String?  // Contract name from blueprint
  eventType       String?  // Event type (transfer, mint, burn, etc.)
  schemaVersion   String?  // Blueprint schema version that translated this event (e.g. "v2", "1.0.0")
  executionDagId  String?  // FK to ExecutionDag (a tx can produce multiple events)
  // Postgres full-text search vector (tsvector), maintained by DB trigger —
  // see migration 20260904000000_add_event_full_text_search (issue #409).
  searchVector    Unsupported("tsvector")?

  // Source tag lets callers distinguish live-indexed from backfilled events.
  // "live"       — emitted by the real-time Soroban/Horizon indexer
  // "historical" — backfilled by POST /api/ingest-historical
  // null         — pre-migration rows (treated as "live" by convention)
  source          String?  // "live" | "historical"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executionDag    ExecutionDag? @relation(fields: [executionDagId], references: [id])

  @@index([contractId])
  @@index([ledger])
  @@index([txHash])
  @@index([contractId, ledger])
  @@index([timestamp])
  @@index([source])
  @@index([schemaVersion])
}

model DeadLetterEvent {
  id            String   @id @default(cuid()) @unique
  eventId       String
  contractId    String
  ledger        Int
  timestamp     Int
  txHash        String
  topics        Json
  data          String
  errorCode     String
  errorMessage  String
  errorStack    String?
  errorContext  Json?
  createdAt     DateTime @default(now())

  @@index([contractId])
  @@index([eventId])
  @@index([createdAt])
}

// Tracks indexer progress for both the live and historical ingestion paths.
//
// Well-known id values
// ────────────────────
// "current"                — live Soroban / Horizon indexer  (lib/db/utils.ts → updateCursor)
// "historical:<contractId>"— per-contract historical backfill (lib/stellar/historical-ingester.ts → updateHistoricalCursor)
// "historical:global"      — legacy / contract-agnostic historical runs
//
// Using separate ids prevents the two paths from ever overwriting each other.
// The `lastProcessed` field records the wall-clock time of the last write so
// operators can detect a stalled indexer or backfill at a glance.
model IndexerCursor {
  id              String   @id
  lastLedger      Int      @default(0)
  lastProcessed   DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lastLedger])
}

// Webhook subscription registered by an external consumer
model WebhookSubscription {
  id          String   @id @default(cuid())
  url         String
  contractId  String?  // null = subscribe to all contracts
  secretHash  String   // HMAC secret stored as scrypt-derived hash
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]

  @@index([isActive])
  @@index([contractId])
}

// Execution DAG — reconstructed call tree for a Soroban transaction
model ExecutionDag {
  id               String   @id @default(cuid())
  txHash           String   @unique
  ledger           Int
  timestamp        Int
  nodes            Json     // DagNode[] serialized
  maxDepth         Int
  uniqueContracts  Int
  hasReentrancy    Boolean  @default(false)
  reentrancyDetails Json   // ReentrancyInfo[] serialized
  authTraces       Json     // AuthTrace[] serialized
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events           Event[]

  @@index([ledger])
  @@index([txHash])
  @@index([hasReentrancy])
  @@index([ledger, hasReentrancy])
}

// Record of each delivery attempt for auditing and debugging
model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  eventId        String
  httpStatus     Int?     // null when delivery failed before a response
  succeeded      Boolean
  attempts       Int      @default(1)
  createdAt      DateTime @default(now())

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([eventId])
  @@index([subscriptionId, eventId])
}

// Database-backed API Key store for v1 REST API authentication
model ApiKey {
  id          String   @id @default(cuid())
  hashedKey   String   @unique
  appName     String
  owner       String
  tier        String   // "free" | "partner"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  @@index([hashedKey])
  @@index([isActive])
}
