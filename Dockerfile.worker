# Standalone indexer worker for the decoupled microservices architecture.
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx prisma generate && npm run build:server

FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 openaudit && \
    adduser --system --uid 1001 openaudit

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/.server-dist ./.server-dist
COPY --from=builder /app/prisma ./prisma

USER openaudit

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "const Redis=require('ioredis');const r=new Redis(process.env.REDIS_URL||'redis://redis:6379');r.hget('open-audit:worker:heartbeat','lastSeen').then(v=>{r.quit();process.exit(v?0:1)}).catch(()=>process.exit(1))"

CMD ["node", ".server-dist/src/worker/indexer.js"]
